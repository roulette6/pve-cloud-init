#cloud-config
# Vendor data merged with the Proxmox-generated user data. User, password,
# SSH keys, hostname and network come from the native cloud-init drive.
timezone: todo_timezone
package_update: true
package_upgrade: true
package_reboot_if_required: true
packages:
  - qemu-guest-agent
  - ca-certificates
  - chrony
  - cifs-utils
  - curl
  - git
  - gpg
  - nfs-common
  - tmux
  - wget
  - zsh
runcmd:
  # Ubuntu 26.04's initramfs (dracut) leaves a catch-all DHCP .network file that
  # brings the NIC up as ens18 before cloud-init runs, so the rename to eth0 in
  # the static netplan config fails. Drop it and re-apply netplan.
  - rm -f /run/systemd/network/zzzz-dracut-default.network
  - netplan apply
  - systemctl enable --now qemu-guest-agent
